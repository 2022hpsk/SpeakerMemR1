# Copy this file to .env and fill in your credentials (.env is excluded by .gitignore).
# Each runner automatically loads .env at startup (see run_baseline.py / run_mem0.py).
# The QA agent and judge require access to an LLM; configure one option below and leave the others blank.

# -- Option 0 (primary): DeepSeek (--llm-provider deepseek; default model: deepseek-v4-flash) --
# OpenAI-compatible API with Bearer authentication. Use https://api.deepseek.com as base_url.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# -- Option A: Anthropic (--llm-provider anthropic) --
# Use an actual API key (sk-ant-...), not a Claude Code OAuth token.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# -- Option B: Local vLLM / any OpenAI-compatible service (--llm-provider local) --
# Example: vllm serve Qwen/Qwen2.5-7B-Instruct -> base_url=http://localhost:8000/v1
# For a local service, use any nonempty string as the key (e.g., EMPTY).
OPENAI_API_KEY=
OPENAI_BASE_URL=
